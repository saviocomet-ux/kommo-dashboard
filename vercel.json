{
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/simulador", "destination": "/simulador.html" },
    { "source": "/simulador-sdr", "destination": "/simulador.html" },
    { "source": "/sdr", "destination": "/simulador.html" },
    { "source": "/api/:path*", "destination": "/api" }
  ],
  "crons": [
    {
      "path": "/api/cron/sync",
      "schedule": "0 */2 * * *"
    },
    {
      "path": "/api/cron/mlfp-weekly-report",
      "schedule": "0 21 * * 5"
    },
    {
      "path": "/api/cron/daily-report-morning",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/daily-report-evening",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/cron/sla-check",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/trafego-manha",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/trafego-noite",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/auditoria-semanal",
      "schedule": "0 12 * * 1"
    }
  ]
}
